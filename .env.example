# Copy to .env; npm run demo reads this file and starts every local component.
API_MODE=auto
# With no key, that provider is explicitly marked mock.
# One key for Jev, reranking and question generation.
OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest
# Alternative: voyageai/rerank-3
RERANK_MODEL=qwen/qwen3-reranker-8b
QUESTION_MODEL=openai/gpt-6-luna
# Optional development overrides. No cloud account is required.
WEB_PORT=3000
RANKER_PORT=8000
# Leave empty to generate a local demo password, printed only at startup.
DEMO_PASSWORD=
