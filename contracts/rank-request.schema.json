{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "featureSchemaVersion",
    "referenceSetVersion",
    "taxonomyVersion",
    "q",
    "candidates",
    "k"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "featureSchemaVersion": {
      "const": "v1"
    },
    "referenceSetVersion": {
      "const": "refs-v1"
    },
    "taxonomyVersion": {
      "const": "topics-v1"
    },
    "q": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 100
      }
    },
    "k": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "body",
          "n",
          "m"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "n": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "m": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
